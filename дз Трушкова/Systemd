Задание 2:

Пункт 1:
файл create_files.sh:

#!/bin/bash

cd ~

# Основная директория для работы
BASE_DIR="$HOME/scripts_data"

# Проверка существования директории
if [ -d "$BASE_DIR" ]; then
    echo "Директория $BASE_DIR уже существует"
else
    echo "Создание директории $BASE_DIR"
    mkdir -p "$BASE_DIR"
fi

# Создание и заполнение файлов 1-4
for i in {1..4}; do
    FILE_PATH="$BASE_DIR/file_$i.txt"
    
    # Проверка существования файла
    if [ -f "$FILE_PATH" ]; then
        echo "Файл $FILE_PATH уже существует, перезаписываю"
    else
        echo "Создание файла $FILE_PATH"
    fi
    
    # Запись информации в файл
    {
        echo "Информация в файле file_$i.txt"
        echo "Дата создания: $(date)"
        echo "Текущая дата: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "Версия ядра: $(uname -r)"
        echo "Имя компьютера: $(hostname)"
        echo "Пользователь: $(whoami)"
        echo ""
        echo "Список файлов в домашнем каталоге пользователя $(whoami)"
        echo "Домашний каталог: $HOME"
        echo ""
        
        # Список файлов в домашнем каталоге (скрытые тоже)
        ls -la ~/ | head -20
        
        echo ""
        echo "Полный путь домашнего каталога"
        echo "$HOME"
        
        echo ""
        echo "Текущая рабочая директория"
        echo "$(pwd)"
    } > "$FILE_PATH"
    
    echo "Файл $FILE_PATH создан/обновлен"
done

echo "Скрипт завершил выполнение"
echo "Все файлы созданы в директории: $BASE_DIR"

Пункт 2:
файл script.service:

[Unit]
Description=My custom script service
After=network.target
After=multi-user.target

[Service]
# Указываем пользователя для выполнения скрипта
User=script_user
Group=script_user

# Устанавливаем домашнюю директорию пользователя
WorkingDirectory=~

Type=oneshot
ExecStart=/bin/bash /usr/local/bin/create_files.sh
StandardOutput=journal
StandardError=journal

# Создаем необходимые директории при запуске
ExecStartPre=/bin/mkdir -p /home/script_user/scripts_data
ExecStartPre=/bin/chown -R script_user:script_user /home/script_user/scripts_data

[Install]
WantedBy=multi-user.target

Пункт 3:
файл  script.timer:

[Unit]
Description=Run my script every 5 minutes
Requires=script.service

[Timer]
# Запуск каждые 5 минут
OnCalendar=*:0/5
Unit=script.service

# Случайная задержка до 30 секунд для распределения нагрузки
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target

